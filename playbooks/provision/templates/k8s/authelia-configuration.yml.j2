server:
  address: "tcp://0.0.0.0:9091"

telemetry:
  metrics:
    enabled: true
    address: "tcp://0.0.0.0:9959"

log:
  level: info

# Users and groups live in LLDAP (lldap-deployment.yaml). To fall back to the
# old file backend, restore:
#   file:
#     path: /etc/authelia/users_database.yml
# (the authelia-users ConfigMap is still rendered and mounted for that).
# The bind account has LLDAP's lldap_password_manager role so Authelia can
# write password changes and resets; it cannot touch lldap_admin members.
authentication_backend:
  refresh_interval: '1m'
  ldap:
    implementation: 'lldap'
    address: 'ldap://lldap.authelia.svc.cluster.local:3890'
    base_dn: 'DC=arishaig,DC=site'
    user: 'UID=authelia,OU=people,DC=arishaig,DC=site'
    password: '{{ lldap_authelia_bind_password }}'
  password_reset:
    disable: false
  password_change:
    disable: false

session:
  expiration: 12h
  inactivity: 2h
  remember_me: 30d
  redis:
    host: redis
    port: 6379
  cookies:
    - domain: 'arishaig.site'
      authelia_url: 'https://auth.arishaig.site'
  # secret is passed via AUTHELIA_SESSION_SECRET env var

storage:
  local:
    path: /config/db.sqlite3
  # encryption_key is passed via AUTHELIA_STORAGE_ENCRYPTION_KEY env var

access_control:
  # Deny by default: a host matching no rule below is refused.
  default_policy: deny
  rules:
    # Jellyfin bypasses Authelia — uses its own auth
    - domain: jellyfin.arishaig.site
      policy: bypass
    # Apps regular (group "users") accounts may open. Admins keep 2FA; users
    # are password-only (no SMTP, so they cannot enrol a 2FA device). Admin
    # rule first: the first match wins.
    - domain:
        - globe.arishaig.site
        - mealie.arishaig.site
        - storyteller.arishaig.site
        - kiwix.arishaig.site
        - watchback.arishaig.site
      policy: two_factor
      subject: 'group:admins'
    - domain:
        - globe.arishaig.site
        - mealie.arishaig.site
        - storyteller.arishaig.site
        - kiwix.arishaig.site
        - watchback.arishaig.site
      policy: one_factor
      subject: 'group:users'
    # Everything else (Sonarr, Radarr, Proxmox, ...) is admins-only, including
    # services added later.
    - domain: '*.arishaig.site'
      policy: two_factor
      subject: 'group:admins'

regulation:
  max_retries: 5
  find_time: 2m
  ban_time: 10m

theme: 'dark'

# Mailpit (mailpit-deployment.yaml) is a local sink: codes and reset links are
# read in its admin-only UI and relayed by hand. No mail leaves the cluster.
# The startup check is off so a down Mailpit can never stop Authelia booting
# (and with it every forward-auth route).
notifier:
  disable_startup_check: true
  smtp:
    address: 'smtp://mailpit.authelia.svc.cluster.local:1025'
    sender: 'Authelia <authelia@arishaig.site>'
    disable_require_tls: true

identity_providers:
  oidc:
    authorization_policies:
      admins_only:
        default_policy: deny
        rules:
          - policy: one_factor
            subject: 'group:admins'
      users_and_admins:
        default_policy: deny
        rules:
          - policy: one_factor
            subject:
              - 'group:users'
              - 'group:admins'
    hmac_secret: '{{ authelia_oidc_hmac_secret }}'
    jwks:
      - key_id: 'main'
        algorithm: 'RS256'
        use: 'sig'
        key: |
{{ authelia_oidc_jwk_private_key | indent(10, first=True) }}
    # Authelia's defaults (1h access, 90m refresh) drop the claude.ai connector
    # whenever it sits idle; the nest-mcp client uses this longer-lived set.
    lifespans:
      custom:
        mcp_connector:
          access_token: '8h'
          refresh_token: '30d'
    clients:
      - client_id: 'nest-mcp'
        client_name: 'Nest MCP'
        lifespan: 'mcp_connector'
        client_secret: '{{ authelia_oidc_client_secret_nest_mcp_hash }}'
        redirect_uris:
          - 'https://claude.ai/api/mcp/auth_callback'
        scopes:
          - openid
          - profile
          - email
          - address
          - phone
          - groups
          - offline_access
        grant_types:
          - authorization_code
          - refresh_token
        response_types:
          - code
        pkce_challenge_method: S256
        authorization_policy: 'admins_only'
        token_endpoint_auth_method: client_secret_post
        audience:
          - 'https://mcp.arishaig.site'
          - 'https://mcp.arishaig.site/'
      # God's Eye View as a claude.ai custom connector: the mcp-auth sidecar
      # in k8s/apps/gods-eye-view introspects tokens issued to this client.
      - client_id: 'gods-eye-view-mcp'
        client_name: "God's Eye View"
        client_secret: '{{ authelia_oidc_client_secret_gev_mcp_hash }}'
        redirect_uris:
          - 'https://claude.ai/api/mcp/auth_callback'
        scopes:
          - openid
          - profile
          - email
          - offline_access
        grant_types:
          - authorization_code
          - refresh_token
        response_types:
          - code
        pkce_challenge_method: S256
        authorization_policy: 'admins_only'
        token_endpoint_auth_method: client_secret_post
        audience:
          - 'https://globe-mcp.arishaig.site'
          - 'https://globe-mcp.arishaig.site/'
      - client_id: 'mealie'
        client_name: 'Mealie'
        client_secret: '{{ authelia_oidc_client_secret_mealie_hash }}'
        redirect_uris:
          - 'https://mealie.arishaig.site/login'
        scopes:
          - openid
          - profile
          - email
          - groups
        grant_types:
          - authorization_code
        response_types:
          - code
        authorization_policy: 'users_and_admins'
        token_endpoint_auth_method: client_secret_basic
      - client_id: 'storyteller'
        client_name: 'Storyteller'
        client_secret: '{{ authelia_oidc_client_secret_storyteller_hash }}'
        redirect_uris:
          - 'https://storyteller.arishaig.site/api/v2/auth/oidc/callback'
        scopes:
          - openid
          - profile
          - email
        grant_types:
          - authorization_code
        response_types:
          - code
        authorization_policy: 'users_and_admins'
        token_endpoint_auth_method: client_secret_basic
