services:
  db:
    command: >-
      postgres
      -c shared_buffers=4GB
      -c effective_cache_size=8GB
      -c work_mem=32MB
      -c maintenance_work_mem=512MB
    mem_limit: 8g

  search:
    environment:
      SOLR_HEAP: 2g
    # Bumped from 3g during the 2026-08-01 full reindex: Solr's own
    # container hit 94% of its limit (heavy segment-merge I/O while
    # ingesting large collections like recording/release) well before the
    # indexer did. LXC has 8GB+ headroom for this.
    mem_limit: 4g

  musicbrainz:
    mem_limit: 2g

  indexer:
    # 1g was too small for sir's 8 import_threads: the multiprocessing
    # manager got OOM-killed mid-run, cascading into FileNotFoundError
    # crashes across every worker and leaving the Solr index empty for
    # months (2026-08-01 incident). Paired with import_threads reduced
    # to 4 in local/indexer.ini.
    mem_limit: 2g

  valkey:
    mem_limit: 512m
