# Audit output
audit.txt
playbooks/audit-output/

# Retry files
*.retry

# Terraform
terraform/.terraform/
# .terraform.lock.hcl is intentionally committed — pins provider versions
terraform/*.tfstate
terraform/*.tfstate.*
terraform/secrets.tfvars
terraform/.terraform.tfstate.lock.info

# MCP server config (contains credentials)
.mcp.json

# FoundryVTT zip (proprietary, downloaded from license page)
playbooks/provision/files/foundry/*.zip

# Talos cluster secrets (generated by bootstrap-talos.sh — keep offline)
# talosconfig and controlplane.yaml contain cluster CA keys
talos/clusterconfig/
__pycache__/
*.pyc

# Python test/coverage artifacts (mcp/)
.venv*/
mcp/.venv*/
mcp/coverage.xml
mcp/.coverage
.pytest_cache/
*.egg-info/

# Personal listening data (music stack, docs/music-*.md) — never commit.
# Spotify Extended Streaming History export and anything derived from it.
spotify-history/
**/Streaming_History_*.json
**/my_spotify_data*.zip
**/my_spotify_data/
# lidarr-triage outputs contain play-derived reports and action logs
tools/lidarr-triage/reports/
tools/lidarr-triage/runs/
